<button id="clear" class="secondary">Очистить форму</button>
<p id="msg"></p>
</div>
</div>
<script>
(function(){
  const scores=[...document.querySelectorAll('.score')];
  const max=scores.length*3;
  function update(){
    let earned=0, answered=0;
    scores.forEach(s=>{if(s.value!==""){earned+=Number(s.value);answered++;}});
    const value=Math.round(earned/max*100);
    document.getElementById('total').textContent=value;
    document.getElementById('grade').textContent=answered===0?'Оцените пункты чек-листа':value>=90?'Отлично':value>=75?'Хорошо':value>=60?'Требует улучшений':'Неудовлетворительно';
  }
  scores.forEach(s=>s.addEventListener('change',update));
  document.getElementById('date').value=new Date().toISOString().slice(0,10);
  document.getElementById('pdf').addEventListener('click',function(){
    document.getElementById('msg').textContent='В окне печати выберите «Сохранить как PDF».';
    window.print();
  });
  document.getElementById('clear').addEventListener('click',function(){
    if(confirm('Очистить всю форму?')) location.reload();
  });
})();
</script>
