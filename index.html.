<!doctype html>
<html lang="ru">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Контроль вейп-магазинов</title>
<style>
*{box-sizing:border-box}
body{margin:0;padding:14px;background:#f3f4f6;color:#222;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Arial,sans-serif}
#app{max-width:900px;margin:auto}
h1{font-size:25px;margin:4px 0 18px}
h2{font-size:19px;margin:0 0 14px}
.card{background:white;border:1px solid #d8d8d8;border-radius:16px;padding:16px;margin:12px 0;box-shadow:0 1px 2px #00000008}
.grid{display:grid;grid-template-columns:1fr 1fr;gap:12px}
label{display:block;font-size:14px;color:#555;margin:0 0 5px}
input,select,textarea{width:100%;min-width:0;border:1px solid #bdbdbd;border-radius:10px;padding:11px;font:inherit;background:white}
textarea{min-height:100px;resize:vertical}
.score{max-width:95px}
.check-row{display:grid;grid-template-columns:minmax(0,1fr) 95px minmax(120px,0.8fr);gap:9px;align-items:center;border-top:1px solid #eee;padding:10px 0}
.check-row:first-of-type{border-top:0}
.check-name{font-size:15px;line-height:1.3}
.inventory-row{display:grid;grid-template-columns:minmax(0,1fr) 150px minmax(120px,0.8fr);gap:9px;align-items:center;border-top:1px solid #eee;padding:9px 0}
.inventory-row:first-child{border-top:0}
.inventory-name{font-size:15px;line-height:1.3}
.total{font-size:36px;font-weight:800}
button{border:0;border-radius:10px;padding:13px 17px;background:#1769aa;color:white;font-size:16px;font-weight:700;margin:4px 5px 4px 0}
button.secondary{background:#666}
small{color:#666}
@media(max-width:650px){
 body{padding:8px}
 .grid{grid-template-columns:1fr}
 .check-row{grid-template-columns:minmax(0,1fr) 70px}
 .check-row .note{grid-column:1 / -1}
 .inventory-row{grid-template-columns:minmax(0,1fr) 100px}
 .inventory-row input:last-child{grid-column:1 / -1}
 h1{font-size:23px}
}
@media print{
 body{background:white;padding:0;font-size:11px}
 .no-print{display:none!important}
 .card{box-shadow:none;break-inside:avoid;border:1px solid #aaa;border-radius:0;margin:6px 0;padding:9px}
 h1{font-size:18px}
 h2{font-size:14px}
 input,select,textarea{border:0;padding:2px;border-radius:0}
 .check-row,.inventory-row{padding:4px 0;gap:5px}
}
</style>
</head>
